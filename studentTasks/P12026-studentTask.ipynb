   "source": [
    "## Question 2: Collect and Compare API Facts\n",
    "\n",
    "Write code that calls `https://catfact.ninja/fact` three times and then:\n",
    "\n",
    "1. Handles request errors safely\n",
    "2. Stores each returned `fact` and `length`\n",
    "3. Prints all three facts as a numbered list\n",
    "4. Prints the average fact length across the 3 responses"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0618f843",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Write your answer for Question 2 here"

import requests

api_url = "https://catfact.ninja/fact"
facts = []
lengths = []

# إرسال الطلب 3 مرات
for i in range(3):
    try:
        response = requests.get(api_url, timeout=5)
        response.raise_for_status() # التأكد من أن الطلب نجح بنجاح (Status 200)
        
        data = response.json()
        facts.append(data['fact'])
        lengths.append(data['length'])
        
    except requests.exceptions.RequestException as e:
        print(f"Request {i+1} failed: {e}")

# طباعة النتائج وحساب المتوسط في حال نجاح الطلبات
if facts:
    print("\n--- Cat Facts List ---")
    for index, fact in enumerate(facts, 1):
        print(f"{index}. {fact}")
        
    # حساب المتوسط الحسابي لأطوال النصوص المستلمة
    avg_length = sum(lengths) / len(lengths)
    print(f"\nAverage fact length: {avg_length:.2f} characters")
else:
    print("Could not retrieve any facts due to API or connection errors.")
   ]
  }
