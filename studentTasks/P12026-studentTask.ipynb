   "source": [
    "## Question 1: PDF Mini Summary\n",
    "\n",
    "Use `./pdfExample.pdf` and write code that:\n",
    "\n",
    "1. Reads page 1 and page 2 (if page 2 exists)\n",
    "2. Calculates how many words are in each extracted page text\n",
    "3. Prints which page has more words\n",
    "4. Prints the word counts for both pages"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0d04ceb8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Write your answer for Question 1 here"
import os
from PyPDF2 import PdfReader

pdf_path = "./pdfExample.pdf"

if os.path.exists(pdf_path):
    reader = PdfReader(pdf_path)
    total_pages = len(reader.pages)
    
    # قراءة الصفحة الأولى (الفهرس 0 في بايثون)
    page1_text = reader.pages[0].extract_text() or ""
    words_page1 = len(page1_text.split())
    
    # قراءة الصفحة الثانية إن وجدت (الفهرس 1)
    words_page2 = 0
    if total_pages >= 2:
        page2_text = reader.pages[1].extract_text() or ""
        words_page2 = len(page2_text.split())
    
    # طباعة عدد الكلمات لكل صفحة
    print(f"Page 1 word count: {words_page1}")
    if total_pages >= 2:
        print(f"Page 2 word count: {words_page2}")
    else:
        print("Page 2 does not exist.")
        
    # تحديد وتوضيح الصفحة التي تحتوي على كلمات أكثر
    if words_page1 > words_page2:
        print("Result: Page 1 has more words.")
    elif words_page2 > words_page1:
        print("Result: Page 2 has more words.")
    else:
        print("Result: Both pages have the exact same number of words.")
else:
    print(f"Error: The file {pdf_path} was not found.")
   ]
  },
